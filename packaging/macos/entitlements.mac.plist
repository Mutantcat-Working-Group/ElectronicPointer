<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Signing entitlements. The application is not sandboxed: it captures the screen, sits
     above other windows and takes over the keyboard, and a sandboxed build would have to
     ask for every one of those powers. Only the hardened runtime exceptions .NET and Skia
     actually need are listed.

     Pass this file to codesign together with a real signing identity, using the deep,
     force and runtime flags: codesign deep-force-runtime-entitlements plus the path
     above, signed as "Developer ID Application: ..." over "ElectronicPointer.app".
     The option names are spelled out here rather than written as flags because an XML
     comment may not contain two consecutive dashes.      -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- The payload is a framework-dependent+contained tree: libSkiaSharp.dylib and the
       libSystem.Native libraries are not signed by the same identity, and the hardened
       runtime refuses to load them without this. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
