<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ElectronicPointer.Rendering</AssemblyName>
    <RootNamespace>Mutantcat.ElectronicPointer.Rendering</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElectronicPointer.Core\ElectronicPointer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <!-- SkiaSharp's own net9.0 dependency group carries only NativeAssets.Win32 and
         NativeAssets.macOS, never the Linux one, so the library that draws with Skia has to
         name it itself. Without this, Linux only gets libSkiaSharp.so because some
         transitive package happened to bring it, and anything that references this project
         directly, the renderer's tests for one, dies on "Unable to load shared library
         'libSkiaSharp'" there. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />
  </ItemGroup>

</Project>
